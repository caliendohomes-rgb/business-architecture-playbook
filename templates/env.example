# Copy to .env and fill in real values. Never commit .env — see docs/secrets-management.md
# Naming convention: <VENDOR>_<PURPOSE>. Client-exposed vars get your framework's public prefix
# (e.g. PUBLIC_ / NEXT_PUBLIC_) applied ON TOP of the name below — add it at the call site,
# don't rename the vendor's own var.

# --- Supabase ---
# Dashboard > Project Settings > API. URL and anon key are safe to expose to the client.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Service role key: SERVER-SIDE ONLY. Netlify Functions env var, secret-tagged. Never in client bundle.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Stripe ---
# Dashboard > Developers > API keys. Publishable key is safe to expose; secret key is NOT.
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Dashboard > Developers > Webhooks > (your endpoint) > Signing secret. Different per environment/endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Dashboard > Product catalog. One per plan. Never hardcode these in app code.
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...

# --- Resend (transactional email) ---
# resend.com/api-keys. Server-side only.
RESEND_API_KEY=re_...
EMAIL_FROM="Your App <notifications@yourdomain.com>"

# --- Sentry ---
# DSN is safe to expose client-side (it's a write-only endpoint identifier, not a secret).
PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# --- Plausible ---
PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# --- App ---
PUBLIC_APP_URL=http://localhost:8888
